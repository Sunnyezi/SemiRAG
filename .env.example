# Chat model selection: use either "deepseek" or "openai".
LLM_PROVIDER=deepseek

# Active when LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Active only when LLM_PROVIDER=openai. This supports OpenAI-compatible services.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://xiaoai.plus/v1
OPENAI_MODEL=gpt-4o-mini

# Required only when the adaptive workflow uses Tavily web search.
TAVILY_API_KEY=

# Milvus connection and local knowledge-base directory.
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=semirag_knowledge_base
KNOWLEDGE_BASE_DIR=data/knowledge_base/semiconductor
