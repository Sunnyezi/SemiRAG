# OpenAI-compatible provider used by the default chat and embedding setup.
OPENAI_API_KEY=

# Required only after enabling the DeepSeek configuration in src/semirag/models/all_llm.py.
DEEPSEEK_API_KEY=

# Required only when the adaptive workflow uses Tavily web search.
TAVILY_API_KEY=

# Local runtime configuration.
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=semirag_knowledge_base
KNOWLEDGE_BASE_DIR=data/knowledge_base/semiconductor
